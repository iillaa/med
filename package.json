{
  "name": "drcat",
  "version": "1.7.6",
  "description": "Dr.CAT — Clinical Review App",
  "author": "Dr. Kibeche Ali Dia Eddine",
  "copyright": "Copyright (c) 2026 Dr. Kibeche Ali Dia Eddine. All rights reserved.",
  "main": "server/index.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "start:admin": "node server.js",
    "pm2:start": "node /data/data/com.termux/files/usr/lib/node_modules/pm2/bin/pm2 start ecosystem.config.js",
    "pm2:stop": "node /data/data/com.termux/files/usr/lib/node_modules/pm2/bin/pm2 stop drcat",
    "pm2:restart": "node /data/data/com.termux/files/usr/lib/node_modules/pm2/bin/pm2 restart drcat",
    "pm2:status": "node /data/data/com.termux/files/usr/lib/node_modules/pm2/bin/pm2 list",
    "pm2:logs": "node /data/data/com.termux/files/usr/lib/node_modules/pm2/bin/pm2 logs drcat --lines 50",
    "log:rotate": "node scripts/rotate-logs.js",
    "test": "node tests/headless/harness.mjs smoke",
    "test:suite": "node tests/run_all_tests.js",
    "test:safe": "node tests/headless/harness.mjs safeAreas",
    "test:console": "node tests/headless/harness.mjs console",
    "test:theme": "node tests/headless/harness.mjs themeReveal",
    "build": "node build.js",
    "build:bundle": "node build-bundle.js",
    "compress:pdfs": "node scripts/compress_pdfs.js",
    "reindex": "node index_pdfs.js",
    "cap:sync": "node node_modules/@capacitor/cli/bin/capacitor sync android && node scripts/clean_android_assets.js",
    "set:password": "node set_admin_password.js",
    "set:provider": "node set_server_provider.js"
  },
  "keywords": [
    "medical",
    "clinical",
    "drcat"
  ],
  "license": "Proprietary",
  "dependencies": {
    "@capacitor/android": "^7.6.8",
    "@capacitor/app": "^7.1.2",
    "@capacitor/core": "^7.6.8",
    "@capacitor/filesystem": "^7.1.8",
    "@capacitor/haptics": "^7.0.5",
    "@capacitor/keyboard": "^7.0.6",
    "@capacitor/share": "^7.0.4",
    "@capacitor/status-bar": "^7.0.6",
    "compression": "^1.8.1",
    "cors": "^2.8.6",
    "dompurify": "^3.4.12",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "pdf-parse": "2.4.5"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.6.8",
    "esbuild": "^0.28.1",
    "eslint": "^8.57.1",
    "jscpd": "^5.0.12",
    "knip": "^6.27.0",
    "puppeteer-core": "^23.0.0"
  }
}
